{
  "id": "./?app=skipper-sardinien-korsika-v0",
  "name": "Skipper-Assistent Sardinien-Korsika",
  "short_name": "Skipper Sardinien",
  "description": "Offline-Skipperassistent: Lagebewertung, Zuflucht, Ankerbuchten, Notfall, Regeln (Sardinien und Korsika)",
  "lang": "de",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12141f",
  "theme_color": "#12141f",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "gpx",
          "accept": [
            "application/gpx+xml",
            ".gpx",
            "application/octet-stream",
            "text/xml",
            "application/xml"
          ]
        }
      ]
    }
  }
}
